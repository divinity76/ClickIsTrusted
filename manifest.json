{
  "name": "ClickIsTrusted",
  "version": "1.1.3",
  "description": "The devil is in the devtools!",
  "manifest_version": 3,
  "minimum_chrome_version": "118",
  "permissions": [
    "debugger",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "contentScript.js"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "images/black_16.png",
      "32": "images/black_32.png",
      "48": "images/black.png",
      "128": "images/black.png"
    }
  },
  "icons": {
    "16": "images/black_16.png",
    "32": "images/black_32.png",
    "48": "images/black.png",
    "128": "images/black.png"
  }
}
